// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  // Human-facing staff number. 6 digits, from a sequence starting at 100000 (see migration).
  employeeNumber Int            @unique @default(autoincrement())
  email          String
  password       String // argon2 hash. While PENDING, this is the temporary password's hash
  firstName      String
  lastName       String
  middleName     String?
  role           Role           @default(EMPLOYEE)
  status         EmployeeStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime? // set when the employee is soft-deleted; null means active

  // Activation: set when an admin creates the account, cleared once the employee activates
  activationTokenHash String?   @unique // SHA-256 of the token in the activation link (the token itself is only in the email)
  activationExpiresAt DateTime? // invite stops working after this (48h after creation)
  activatedAt         DateTime?

  // Two-factor auth (TOTP authenticator app)
  twoFactorEnabled   Boolean   @default(true)
  twoFactorSecret    String? // encrypted with TOTP_ENCRYPTION_KEY; set during activation
  lastTotpStep       Int? // 30-second period of the last accepted code, so each code works only once
  failedTotpAttempts Int       @default(0) // wrong codes in a row, across all login attempts
  totpLockedUntil    DateTime? // set after too many wrong codes; no codes are accepted until then

  addresses       Address[] // one employee has many addresses
  sessions        Session[]
  loginChallenges LoginChallenge[]
}

// One row per logged-in device. The cookie holds a random token; only its hash is stored here.
model Session {
  id                String   @id @default(uuid(7)) @db.Uuid
  tokenHash         String   @unique // SHA-256 of the session cookie value
  employeeId        String   @db.Uuid
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rememberMe        Boolean
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  expiresAt         DateTime // pushed forward while the employee is active (idle timeout), never past absoluteExpiresAt
  absoluteExpiresAt DateTime // hard limit from login time; never moves
  userAgent         String?
  ipAddress         String?

  @@index([employeeId])
}

// Password was correct, 2FA code not entered yet. Lives 5 minutes; exchanged for a Session.
model LoginChallenge {
  id         String   @id @default(uuid(7)) @db.Uuid
  tokenHash  String   @unique // SHA-256 of the login challenge cookie value
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rememberMe Boolean // chosen at the password step, copied onto the session
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum EmployeeStatus {
  PENDING // invited by an admin, hasn't activated yet
  ACTIVE
}

model Address {
  id        String    @id @default(uuid(7)) @db.Uuid
  stNo      String?
  stName    String?
  suburb    String?
  city      String?
  state     String?
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // each address belongs to one employee
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}
