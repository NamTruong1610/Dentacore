// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id         String    @id @default(uuid(7)) @db.Uuid
  email      String
  password   String
  firstName  String
  lastName   String
  middleName String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // set when the employee is soft-deleted; null means active

  addresses Address[] // one employee has many addresses

  // email must be unique among active employees; soft-deleted employees don't block it
  @@unique([email], where: { deletedAt: null })
}

model Address {
  id        String    @id @default(uuid(7)) @db.Uuid
  stNo      String?
  stName    String?
  suburb    String?
  city      String?
  state     String?
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // each address belongs to one employee
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}
