# Copy to .env and adjust. docker compose reads .env automatically.
PORT=3000

POSTGRES_USER=dentacore
POSTGRES_PASSWORD=dentacore
POSTGRES_DB=dentacore

RABBITMQ_USER=dentacore
RABBITMQ_PASSWORD=dentacore

# Ports on your Mac. Picked to avoid clashing with your other Docker projects.
POSTGRES_PORT=5435
REDIS_PORT=6381
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673

# For running the app on your host (npm run start:dev) against the containers:
DATABASE_URL=postgres://dentacore:dentacore@localhost:5435/dentacore
REDIS_URL=redis://localhost:6381
RABBITMQ_URL=amqp://dentacore:dentacore@localhost:5673
