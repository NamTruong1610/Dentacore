# Copy to .env and adjust. docker compose reads .env automatically.
PORT=3000

POSTGRES_USER=dentacore
POSTGRES_PASSWORD=dentacore
POSTGRES_DB=dentacore

RABBITMQ_USER=dentacore
RABBITMQ_PASSWORD=dentacore

# Ports on your Mac. Picked to avoid clashing with your other Docker projects.
POSTGRES_PORT=5435
REDIS_PORT=6381
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673

# For running the app on your host (npm run start:dev) against the containers:
DATABASE_URL=postgres://dentacore:dentacore@localhost:5435/dentacore
REDIS_URL=redis://localhost:6381
RABBITMQ_URL=amqp://dentacore:dentacore@localhost:5673

# Email. In development, Mailpit catches everything: inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER and SMTP_PASSWORD: only needed for a real email provider
MAIL_FROM="Dentacore <no-reply@dentacore.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Employee invites: the activation page (frontend). The emailed link adds ?token=...
ACTIVATION_URL=http://localhost:5173/activate

# Two-factor auth. Key encrypts stored 2FA secrets: 32 random bytes, base64 (openssl rand -base64 32)
TOTP_ISSUER=Dentacore
TOTP_ENCRYPTION_KEY=

# Dev admin created by: npx prisma db seed
SEED_ADMIN_EMAIL=admin@dentacore.local
SEED_ADMIN_PASSWORD=

# Login sessions. FRONTEND_ORIGIN: the frontend allowed to call the API with cookies (comma-separated for several).
# COOKIE_SECURE=true in production (HTTPS only); false for http://localhost.
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Rate limit for login, 2FA, password and activation endpoints: requests per minute, per IP, per endpoint.
AUTH_RATE_LIMIT_PER_MINUTE=20
# Behind a proxy/load balancer (production): how many proxy hops to trust for the client IP, e.g. 1.
# TRUST_PROXY=1

# Encrypts queued messages (outbox table and RabbitMQ): invite emails contain temporary passwords.
# 32 random bytes, base64 (openssl rand -base64 32). Different from TOTP_ENCRYPTION_KEY.
OUTBOX_ENCRYPTION_KEY=
